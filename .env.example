# Puerto del servidor HTTP
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URI de MongoDB Atlas. Reemplaza los valores de ejemplo y codifica caracteres
# especiales de la contraseña en formato URL. No subas credenciales reales.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=library-api

# Nombre de la base de datos
MONGO_DB_NAME=library_api
